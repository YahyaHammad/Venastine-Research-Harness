/* ROADMAP_v2 §16. Colours come from the active theme's variables rather
   than literals, so all eight themes restyle this without edits. */

#main {
    width: 1fr;
}

#sidebar {
    width: 22;
    border-left: solid $panel;
    padding: 1;
}

#transcript {
    height: 1fr;
    border: solid $panel;
    padding: 0 1;
}

#prompt {
    dock: bottom;
    border: solid $primary;
}

#raven {
    height: 5;
    color: $accent;
    content-align: center middle;
}

/* §40. Hidden unless a shipped protection is off; auto height so it
   costs nothing in the shipped posture. $error because the one thing it
   must not read as is decoration. */
#posture-badge {
    height: auto;
    color: $error;
    text-style: bold;
    padding: 1 0 0 0;
}

#effort-raven {
    height: 2;
    color: $secondary;
    content-align: center middle;
}

/* #4 session usage line. Auto height and hidden until the first turn
   gives it figures, like the research panel above. */
#usage-line {
    height: auto;
    padding-top: 1;
    color: $text-muted;
}

/* §22 live research view. Auto height so it takes no sidebar space
   until a run starts, and scrolls rather than pushing the ravens off
   screen on a long retry loop. */
#research-progress {
    height: auto;
    max-height: 20;
    overflow-y: auto;
    padding-top: 1;
    color: $text-muted;
}

PermissionScreen {
    align: center middle;
}

/* Every modal screen gets one of these (#112). Nothing checked that a
   screen had both a type selector and an id block for its dialog, and
   five of nine never got the first -- they measured at x=0, y=0, pinned
   to the top-left corner of an 80x24 terminal. The viewport test in
   tests/test_tui.py pushes all nine and would catch a tenth. */

GrantPickerScreen {
    align: center middle;
}

SubagentSignoffScreen {
    align: center middle;
}

ConfirmScreen {
    align: center middle;
}

ProjectKindScreen {
    align: center middle;
}

ReviewScreen {
    align: center middle;
}

#permission-dialog {
    /* A VERTICAL, not a grid (batch 49). §46 left this a two-column grid
       in which every child carried `column-span: 2`, so the second column
       held nothing but the Deny button -- and `grid-size` being static is
       the only reason the `with-headline` class existed, to tell the
       stylesheet whether the screen had composed three children or four.
       A Vertical does not need telling, so the template somebody had to
       keep in sync is gone rather than commented.
       The `1fr` row EP1 removed is still not to come back: a fractional
       row inside a `height: auto` container resolves to ZERO, and it is
       what made the payload absent from every permission modal this app
       had ever shown. What bounds a long payload is `max-height` on the
       ScrollBox -- see #permission-params-box for why not a definite
       `height`, which is what EP1 shipped and what took the buttons. */
    padding: 1 2;
    /* 90% with a cap, not a fixed 60 (§46, EP1). Width is what decides
       how many rows the notice and the reason cost, and those rows are
       what the command and the payload have to share -- at 60 the
       notice alone wrapped to three. Same shape as #claims-dialog and
       for the same reason (#112): align cannot centre something wider
       than an 80-column terminal, so the cap has to stay under it. */
    width: 90%;
    max-width: 96;
    height: auto;
    /* 22, which is what the deleted `.with-headline` block used: the
       four rows the pinned command takes are the reason that block
       existed, and with one template the taller shape sets the cap.
       Still inside the 24-row floor #112 pins, and `height: auto` means
       a short approval is nowhere near it -- `web_search` measures 14. */
    max-height: 22;
    border: thick $warning;
    background: $surface;
}

/* The blank row between blocks was `grid-gutter: 1 2` and a Vertical
   has no gutter, so it is a margin now. It is not decoration: §46 pinned
   the command OUTSIDE the payload precisely so the two read as separate
   claims about the call, and flush against each other they do not. */
#permission-title {
    text-style: bold;
    margin-bottom: 1;
}

/* The pinned subject of the question (§46, EP1), and the split
   favours it deliberately: the payload below repeats the notice, the
   reason and the command itself, so rows spent here buy the one thing
   nothing else on the screen shows in full. Four is what a wrapped
   `docker run ... bash -c "..."` needs at this width, measured; past
   that it scrolls rather than growing, so a pathological command
   cannot eat the modal. Deliberately not $text-muted -- this is the
   one thing on the screen the reader must actually read. */
#permission-command-box {
    height: auto;
    max-height: 4;
    margin-bottom: 1;
}

#permission-command {
    text-style: bold;
}

/* `auto` WITH a `max-height`, not a definite height (batch 49,
   amending EP3). EP3 got the Static half right -- a Static given
   `max-height` reports no content past the bound, so its hidden rows
   are gone rather than below the fold -- and the ScrollBox half wrong.
   A scrollable container asked for `height: auto` does NOT resolve to
   zero; EP1's `1fr` ROW did, and the box was measured inside one. With
   the row `auto`, a DEFINITE height bounds what the box draws and not
   what its parent reserves, so the row kept growing with the payload
   and pushed the decision bar past the dialog's own `max-height`, where
   it was clipped away -- on nine of fourteen modal shapes, `shell`'s
   among them. `auto` with a `max-height` reports the bound upward, and
   still shrinks to a two-line payload, which a definite height never
   did. Do not "restore" one:
   test_a_bounded_box_reserves_its_bound_not_its_content fails. */
/* 7 rows, and NO margin below it -- the arithmetic is the point.
   A dialog capped at 22 has 18 rows inside it, and the title, its
   margin, the pinned command, its margin and the decision bar claim 11
   of them whether or not the payload wants more. Leaving the last
   blank row off buys the slack a title that wraps to two lines needs,
   which is the one length here that nothing bounds.
   Everything past row 7 is scrollable, and on the shell modal every
   line of it also appears above. */
#permission-params-box {
    height: auto;
    max-height: 7;
}

#permission-params {
    height: auto;
    color: $text-muted;
}

/* THE DECISION BAR (batch 49). One rule for every consent surface,
   because the defect it answers was one defect on nine of them: the
   buttons were the LAST children of a dialog whose body could outgrow
   it, so they were what fell off. In a bar they are one child, and the
   bounded bodies above keep the sum inside the dialog.
   Centred rather than stretched: the dialog was always centred and its
   contents were not -- Allow sat flush against the left padding and a
   16-wide Deny left ~22 dead columns beside it. Filling the columns
   instead would have made the permissive answer a target half the width
   of the modal. `height: auto` so a bar costs exactly its buttons. */
#permission-buttons,
#grant-buttons,
#review-buttons,
#question-buttons {
    height: auto;
    align: center middle;
}

#permission-buttons Button,
#grant-buttons Button,
#review-buttons Button,
#question-buttons Button {
    margin: 0 1;
}

/* FOCUS WITHOUT `reverse` (batch 49). Textual's Button carries
   `text-style: $button-focus-text-style` when focused and this theme
   resolves that to `reverse`, which inverts the LABEL and nothing else
   -- so a focused green Allow drew its word as green on white and read
   as a highlighted selection rather than as the keyboard's position.
   Bold plus a lifted background tints the whole button instead, which
   is what a person actually looks for, and it composes with all
   fourteen palettes because both values come from the theme rather than
   from a literal (#116). */
Button:focus {
    text-style: bold;
    background-tint: $foreground 25%;
}

/* The answer box lines up with the options above it (batch 49).
   Textual's Input takes a `tall` border on all four sides and a Button
   takes one on the top and bottom only, so at the same `x` the Input's
   left edge is drawn a column in from the option buttons' -- close
   enough to look like a mistake and far enough to see. Dropping the two
   side edges gives both widgets the same box, rather than giving the
   buttons a border they do not want. */
#question-text,
#review-note {
    border-left: none;
    border-right: none;
}

ThreadPickerScreen {
    align: center middle;
}

/* §26 claims view. Wider than the other dialogs because claim text is
   prose rather than a label, and primary-bordered rather than
   warning-bordered: this one only reads, it authorises nothing. */
ClaimsScreen {
    align: center middle;
}

#claims-dialog {
    /* 90% with a cap, not a fixed width (#112): at 96 the dialog was
       wider than an 80-column terminal, and align: center middle cannot
       centre something wider than its container -- the right ~16
       columns, tail of every score: line included, sat off-screen. */
    width: 90%;
    max-width: 96;
    height: auto;
    max-height: 22;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#claims-title {
    text-style: bold;
    padding-bottom: 1;
}

/* The Static keeps the colour and the box keeps the bound (batch 49);
   `max-height` on the Static itself was EP3's truncation-without-scroll,
   on the one screen that exists to show every claim. */
#claims-body-box {
    height: auto;
    max-height: 14;
}

/* §25 research grant picker. Warning-bordered like the permission modal
   rather than primary-bordered like the thread picker: both are
   authorization decisions, and looking like the neutral list-of-threads
   dialog would undersell what confirming here does. */
#grant-dialog {
    width: 76;
    height: auto;
    max-height: 22;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#grant-title {
    text-style: bold;
}

#grant-help {
    padding-bottom: 1;
    color: $text-muted;
}

/* 8, not 14 (batch 49). A dialog has 18 rows inside it on the 24-row
   floor, and the title, the two-sentence help, the bar and this list
   have to share them -- at 14 the confirm button was off the bottom
   with twenty tools offered. */
#grant-list {
    height: auto;
    max-height: 8;
    margin-bottom: 1;
}

#thread-dialog {
    width: 70;
    height: auto;
    max-height: 24;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#thread-title {
    text-style: bold;
    padding-bottom: 1;
}

#thread-list {
    height: auto;
    max-height: 18;
}

/* §23 slice 2's question modal. Borrows the grant dialog's proportions --
   both are "read this, then choose" rather than "allow or deny" -- but
   takes the primary border rather than the warning one: this authorises
   nothing, it answers something. */
QuestionScreen {
    align: center middle;
}

#question-dialog {
    width: 66;
    height: auto;
    /* The body is the MODEL's question -- the one length the app does
       not choose (#112). Without a max-height a long question pushed the
       dialog to 45 rows on a 24-row terminal, title off the top and the
       defer button off the bottom. */
    max-height: 22;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#question-title {
    text-style: bold;
    width: 100%;
}

#question-body-box {
    height: auto;
    max-height: 4;
    padding: 1 0;
    width: 100%;
}

#question-body {
    height: auto;
    width: 100%;
}

/* The single-select options. Bounded like the SelectionList the
   multi-select branch uses, and for the same reason -- four options of
   two lines each is 16 rows, and the dialog has 18. */
#question-options {
    height: auto;
    max-height: 6;
    width: 100%;
    margin-bottom: 1;
}

/* FIXED WIDTH, and it is what stops the truncation (batch 49). At
   Button's default `width: auto` an option is as wide as its label
   unwrapped -- measured at 119 columns inside a 60-column dialog, so a
   long option was CUT at the dialog edge, and three options of
   different lengths gave three different right edges. At `width: 100%`
   the same label WRAPS to two centred lines and every option is the
   same size. Nothing is truncated anywhere: ask_user refuses an option
   too long to render rather than shortening it. */
#question-options Button {
    width: 100%;
}

#question-help {
    color: $text-muted;
    padding-bottom: 1;
    width: 100%;
}

#question-list {
    height: auto;
    max-height: 6;
    margin-bottom: 1;
}

/* The sign-off's list is capped like the grant list it is modelled on:
   its length is the subagent's gated tool set, and uncapped it pushed
   the decision buttons off-screen (#112). Capped at 14 it still did --
   #112 bounded the list and nothing bounded the SUM, which is the
   defect batch 49 answers. */
#signoff-list {
    height: auto;
    max-height: 8;
    margin-bottom: 1;
}

/* §20's review consent surface (#112). It had NO rules at all -- full
    screen, top-left, unbordered -- and its body carries reason and
    proposed straight from the reviewer model, so an uncapped body pushed
    the four decision buttons below the fold. Warning-bordered like
    permission/grant rather than primary like claims/question: this one
    AUTHORISES AN EDIT to a finished research run. */
#review-dialog {
    width: 76;
    height: auto;
    max-height: 22;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#review-title {
    text-style: bold;
}

#review-body-box {
    height: auto;
    max-height: 8;
}

#review-body {
    height: auto;
}

/* §38's collapsed thinking line. `height: auto` and hidden until a span
   starts, so it costs no rows when tui.show_thinking is on -- the same
   arrangement the checklist below uses for its unfilled slots. */
#thinking-indicator {
    height: auto;
    padding: 0 1;
}

/* §23 slice 2's checklist. `height: auto` so an empty list costs no rows in
   whichever slot tui.todo_position put it in -- the widget hides itself, and
   this is what makes the unused slots free. */
#todo-panel {
    height: auto;
    max-height: 14;
    overflow-y: auto;
    padding: 0 1;
    color: $text-muted;
}
