/* ROADMAP_v2 §16. Colours come from the active theme's variables rather
   than literals, so all eight themes restyle this without edits. */

#main {
    width: 1fr;
}

#sidebar {
    width: 22;
    border-left: solid $panel;
    padding: 1;
}

#transcript {
    height: 1fr;
    border: solid $panel;
    padding: 0 1;
}

#prompt {
    dock: bottom;
    border: solid $primary;
}

#raven {
    height: 5;
    color: $accent;
    content-align: center middle;
}

/* §40. Hidden unless a shipped protection is off; auto height so it
   costs nothing in the shipped posture. $error because the one thing it
   must not read as is decoration. */
#posture-badge {
    height: auto;
    color: $error;
    text-style: bold;
    padding: 1 0 0 0;
}

#effort-raven {
    height: 2;
    color: $secondary;
    content-align: center middle;
}

/* #4 session usage line. Auto height and hidden until the first turn
   gives it figures, like the research panel above. */
#usage-line {
    height: auto;
    padding-top: 1;
    color: $text-muted;
}

/* §22 live research view. Auto height so it takes no sidebar space
   until a run starts, and scrolls rather than pushing the ravens off
   screen on a long retry loop. */
#research-progress {
    height: auto;
    max-height: 20;
    overflow-y: auto;
    padding-top: 1;
    color: $text-muted;
}

PermissionScreen {
    align: center middle;
}

/* Every modal screen gets one of these (#112). Nothing checked that a
   screen had both a type selector and an id block for its dialog, and
   five of nine never got the first -- they measured at x=0, y=0, pinned
   to the top-left corner of an 80x24 terminal. The viewport test in
   tests/test_tui.py pushes all nine and would catch a tenth. */

GrantPickerScreen {
    align: center middle;
}

SubagentSignoffScreen {
    align: center middle;
}

ConfirmScreen {
    align: center middle;
}

ProjectKindScreen {
    align: center middle;
}

ReviewScreen {
    align: center middle;
}

#permission-dialog {
    grid-size: 2 3;
    grid-gutter: 1 2;
    grid-rows: auto 1fr auto;
    padding: 1 2;
    width: 60;
    height: auto;
    max-height: 20;
    border: thick $warning;
    background: $surface;
}

#permission-title {
    column-span: 2;
    text-style: bold;
}

#permission-params {
    column-span: 2;
    height: auto;
    max-height: 10;
    overflow-y: auto;
    color: $text-muted;
}

ThreadPickerScreen {
    align: center middle;
}

/* §26 claims view. Wider than the other dialogs because claim text is
   prose rather than a label, and primary-bordered rather than
   warning-bordered: this one only reads, it authorises nothing. */
ClaimsScreen {
    align: center middle;
}

#claims-dialog {
    /* 90% with a cap, not a fixed width (#112): at 96 the dialog was
       wider than an 80-column terminal, and align: center middle cannot
       centre something wider than its container -- the right ~16
       columns, tail of every score: line included, sat off-screen. */
    width: 90%;
    max-width: 96;
    height: auto;
    max-height: 22;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#claims-title {
    text-style: bold;
    padding-bottom: 1;
}

#claims-body {
    height: auto;
    max-height: 14;
    overflow-y: auto;
}

/* §25 research grant picker. Warning-bordered like the permission modal
   rather than primary-bordered like the thread picker: both are
   authorization decisions, and looking like the neutral list-of-threads
   dialog would undersell what confirming here does. */
#grant-dialog {
    width: 76;
    height: auto;
    max-height: 22;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#grant-title {
    text-style: bold;
}

#grant-help {
    padding-bottom: 1;
    color: $text-muted;
}

#grant-list {
    height: auto;
    max-height: 14;
    margin-bottom: 1;
}

#thread-dialog {
    width: 70;
    height: auto;
    max-height: 24;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#thread-title {
    text-style: bold;
    padding-bottom: 1;
}

#thread-list {
    height: auto;
    max-height: 18;
}

/* §23 slice 2's question modal. Borrows the grant dialog's proportions --
   both are "read this, then choose" rather than "allow or deny" -- but
   takes the primary border rather than the warning one: this authorises
   nothing, it answers something. */
QuestionScreen {
    align: center middle;
}

#question-dialog {
    width: 66;
    height: auto;
    /* The body is the MODEL's question -- the one length the app does
       not choose (#112). Without a max-height a long question pushed the
       dialog to 45 rows on a 24-row terminal, title off the top and the
       defer button off the bottom. */
    max-height: 22;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#question-title {
    text-style: bold;
    width: 100%;
}

#question-body {
    padding: 1 0;
    width: 100%;
    overflow-y: auto;
}

#question-help {
    color: $text-muted;
    padding-bottom: 1;
    width: 100%;
}

#question-list {
    height: auto;
    max-height: 8;
    margin-bottom: 1;
}

/* The sign-off's list is capped like the grant list it is modelled on:
   its length is the subagent's gated tool set, and uncapped it pushed
   the decision buttons off-screen (#112). */
#signoff-list {
    height: auto;
    max-height: 14;
    margin-bottom: 1;
}

/* §20's review consent surface (#112). It had NO rules at all -- full
    screen, top-left, unbordered -- and its body carries reason and
    proposed straight from the reviewer model, so an uncapped body pushed
    the four decision buttons below the fold. Warning-bordered like
    permission/grant rather than primary like claims/question: this one
    AUTHORISES AN EDIT to a finished research run. */
#review-dialog {
    width: 76;
    height: auto;
    max-height: 22;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#review-title {
    text-style: bold;
}

#review-body {
    height: auto;
    max-height: 10;
    overflow-y: auto;
}

/* §38's collapsed thinking line. `height: auto` and hidden until a span
   starts, so it costs no rows when tui.show_thinking is on -- the same
   arrangement the checklist below uses for its unfilled slots. */
#thinking-indicator {
    height: auto;
    padding: 0 1;
}

/* §23 slice 2's checklist. `height: auto` so an empty list costs no rows in
   whichever slot tui.todo_position put it in -- the widget hides itself, and
   this is what makes the unused slots free. */
#todo-panel {
    height: auto;
    max-height: 14;
    overflow-y: auto;
    padding: 0 1;
    color: $text-muted;
}
