/* ROADMAP_v2 §16. Colours come from the active theme's variables rather
   than literals, so all eight themes restyle this without edits. */

#main {
    width: 1fr;
}

#sidebar {
    width: 22;
    border-left: solid $panel;
    padding: 1;
}

#transcript {
    height: 1fr;
    border: solid $panel;
    padding: 0 1;
}

#prompt {
    dock: bottom;
    border: solid $primary;
}

#raven {
    height: 5;
    color: $accent;
    content-align: center middle;
}

#effort-raven {
    height: 2;
    color: $secondary;
    content-align: center middle;
}

/* §22 live research view. Auto height so it takes no sidebar space
   until a run starts, and scrolls rather than pushing the ravens off
   screen on a long retry loop. */
#research-progress {
    height: auto;
    max-height: 20;
    overflow-y: auto;
    padding-top: 1;
    color: $text-muted;
}

PermissionScreen {
    align: center middle;
}

#permission-dialog {
    grid-size: 2 3;
    grid-gutter: 1 2;
    grid-rows: auto 1fr auto;
    padding: 1 2;
    width: 60;
    height: auto;
    max-height: 20;
    border: thick $warning;
    background: $surface;
}

#permission-title {
    column-span: 2;
    text-style: bold;
}

#permission-params {
    column-span: 2;
    height: auto;
    max-height: 10;
    overflow-y: auto;
    color: $text-muted;
}

ThreadPickerScreen {
    align: center middle;
}

/* §26 claims view. Wider than the other dialogs because claim text is
   prose rather than a label, and primary-bordered rather than
   warning-bordered: this one only reads, it authorises nothing. */
ClaimsScreen {
    align: center middle;
}

#claims-dialog {
    width: 96;
    height: auto;
    max-height: 32;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#claims-title {
    text-style: bold;
    padding-bottom: 1;
}

#claims-body {
    height: auto;
    max-height: 26;
    overflow-y: auto;
}

/* §25 research grant picker. Warning-bordered like the permission modal
   rather than primary-bordered like the thread picker: both are
   authorization decisions, and looking like the neutral list-of-threads
   dialog would undersell what confirming here does. */
#grant-dialog {
    width: 76;
    height: auto;
    max-height: 26;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#grant-title {
    text-style: bold;
}

#grant-help {
    padding-bottom: 1;
    color: $text-muted;
}

#grant-list {
    height: auto;
    max-height: 14;
    margin-bottom: 1;
}

#thread-dialog {
    width: 70;
    height: auto;
    max-height: 24;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#thread-title {
    text-style: bold;
    padding-bottom: 1;
}

#thread-list {
    height: auto;
    max-height: 18;
}

/* §23 slice 2's question modal. Borrows the grant dialog's proportions --
   both are "read this, then choose" rather than "allow or deny" -- but
   takes the primary border rather than the warning one: this authorises
   nothing, it answers something. */
QuestionScreen {
    align: center middle;
}

#question-dialog {
    width: 66;
    height: auto;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#question-title {
    text-style: bold;
    width: 100%;
}

#question-body {
    padding: 1 0;
    width: 100%;
}

#question-help {
    color: $text-muted;
    padding-bottom: 1;
    width: 100%;
}

#question-list {
    height: auto;
    max-height: 8;
    margin-bottom: 1;
}
