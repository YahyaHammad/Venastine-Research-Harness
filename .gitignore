.ipynb_checkpoints/
.env
*.pyc
logs/
*.log
*.db
# SQLite's WAL sidecars, which §47 slice 8 made permanent fixtures of a
# running harness (NA18). `*.db` does not match them -- they end `-wal`
# and `-shm` -- and a `-wal` file holds recently written message rows, so
# without these an `add -A` from the repo root stages conversation
# content. Both are listed rather than `app.db*`, so a database named
# something else is still covered.
*.db-wal
*.db-shm
providers.json
.qwen/
.zcode/
output/
CLAUDE-SECURITY-*/
.pytest_cache/

# Build residue. pyproject.toml (#144) is metadata-only -- nothing here is
# meant to be built or installed -- but any `pip install`, metadata read or
# dry run against it still drops these.
*.egg-info/
build/
dist/

# npm channel (batch 35). node_modules/ never appears in a normal checkout --
# the launcher has zero dependencies -- but `npm install` in this directory
# creates it, and `npm pack` drops a .tgz beside it. Neither belongs in a
# commit, and the `files` allowlist in package.json is what keeps them out of
# the tarball.
node_modules/
*.tgz
