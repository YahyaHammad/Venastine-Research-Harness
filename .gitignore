.ipynb_checkpoints/
.env
*.pyc
logs/
*.log
*.db
# SQLite's WAL sidecars, which §47 slice 8 made permanent fixtures of a
# running harness (NA18). `*.db` does not match them -- they end `-wal`
# and `-shm` -- and a `-wal` file holds recently written message rows, so
# without these an `add -A` from the repo root stages conversation
# content. Both are listed rather than `app.db*`, so a database named
# something else is still covered.
*.db-wal
*.db-shm
providers.json
# ROADMAP_v3 §49 slice 5a. The harness-held secret store's DEFAULT name, in
# case anyone points AGENT_SECRETS_FILE at a checkout. It lives in
# ~/.config/venastine and so is normally nowhere near a repository; this is
# belt and braces, and it costs one line. The file is encrypted either way
# -- that is the actual protection (SS56) -- but a committed ciphertext is
# still an offline guessing target nobody meant to publish.
secrets.json
.qwen/
.zcode/
# docs/REVIEW_MARATHON.md's per-scope reports. Untracked for two measured
# reasons, both in that file: a tracked .md at depths 0-3 is counted EXACTLY
# by test_the_documented_doc_read_bound_is_not_understated, so a reviewer
# adding a report would turn the suite red for every other reviewer; and
# read_project_doc is permission True, so a tracked file is advertised to
# every run -- and a prioritised list of this harness's open defects is the
# worst possible document to put inside that reach while they are open.
review/
output/
CLAUDE-SECURITY-*/
.pytest_cache/

# Build residue. pyproject.toml (#144) is metadata-only -- nothing here is
# meant to be built or installed -- but any `pip install`, metadata read or
# dry run against it still drops these.
*.egg-info/
build/
dist/

# npm channel (batch 35). node_modules/ never appears in a normal checkout --
# the launcher has zero dependencies -- but `npm install` in this directory
# creates it, and `npm pack` drops a .tgz beside it. Neither belongs in a
# commit, and the `files` allowlist in package.json is what keeps them out of
# the tarball.
node_modules/
*.tgz
