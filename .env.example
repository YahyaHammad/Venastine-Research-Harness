# Misc API keys for individual TOOLS -- NOT LLM provider keys.
#
# LLM provider credentials (OpenAI, Anthropic, etc.) live in providers.json,
# managed by credentials.py -- they are NOT read from here. This file is
# exclusively for one-off secrets that a specific tool needs to call some
# third-party grounding/research service.
#
# NO SHIPPED TOOL READS THIS FILE YET (#210). env_secrets.py is ready for
# the first tool that needs one of these keys; until one exists, a key put
# in .env is stored on disk for nothing, so leave it out.
#
# When a tool does need one, copy this file to .env and fill in only the
# keys your registered tools actually need. Leave the rest blank --
# env_secrets.get_env_secret() will raise a clear error at the point of use
# if a tool needs a key you never set, rather than failing silently with an
# empty string.

GITHUB_API_TOKEN=
NVD_API_KEY=
