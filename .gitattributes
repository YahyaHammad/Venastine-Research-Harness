# Auto detect text files and perform LF normalization
* text=auto
*.sh text eol=lf

# Never include local secrets / runtime artifacts in `git archive` (H3/C2).
# .gitignore already keeps them out of `git push`; this keeps them out of
# `git archive` tarballs and GitHub "Download ZIP".
providers.json export-ignore
chatgpt_auth.json export-ignore
chatgpt_auth.json.lock export-ignore
.env export-ignore
secrets.json export-ignore
# S07-02 (batch 144), for .gitignore's reason one channel over: a failed
# rename inside `write_json_atomic` left a complete copy of a credential
# store beside it, and `providers.json export-ignore` does not match
# `providers.json.a1b2c3d4.tmp`.
*.tmp export-ignore
# S18-01 (batch 140), for .gitignore's reason one channel over.
.venastine/mcp.json export-ignore
.venastine/settings.json export-ignore
*.db export-ignore
# The WAL sidecars, for .gitignore's reason one channel over (NA18).
*.db-wal export-ignore
*.db-shm export-ignore
logs/ export-ignore
output/ export-ignore
CLAUDE-SECURITY-* export-ignore
.qwen/ export-ignore
.ipynb_checkpoints/ export-ignore
