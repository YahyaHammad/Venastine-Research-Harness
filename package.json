{
  "name": "@yahyahammad/venastine",
  "version": "0.2.0",
  "description": "A from-scratch agentic harness: tool-using chat plus a ten-pass self-critiquing research pipeline.",
  "keywords": [
    "agent",
    "llm",
    "research",
    "anthropic",
    "openai",
    "mcp"
  ],
  "homepage": "https://github.com/YahyaHammad/Venastine-Research-Harness#readme",
  "bugs": {
    "url": "https://github.com/YahyaHammad/Venastine-Research-Harness/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YahyaHammad/Venastine-Research-Harness.git"
  },
  "license": "Apache-2.0",
  "author": "Yahya Hammad",
  "type": "module",
  "bin": {
    "venastine": "bin/venastine.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node scripts/prepublish-check.mjs",
    "check-pack": "node scripts/prepublish-check.mjs"
  },
  "neverDistribute": [
    {
      "label": "provider credentials",
      "match": "exact",
      "value": [
        "providers.json"
      ],
      "channels": [
        "git",
        "archive",
        "npm"
      ],
      "samples": [
        "providers.json"
      ]
    },
    {
      "label": "tool secrets",
      "match": "basename",
      "value": [
        ".env"
      ],
      "channels": [
        "git",
        "archive",
        "npm"
      ],
      "samples": [
        ".env",
        "sub/.env"
      ]
    },
    {
      "label": "the harness-held secret store",
      "match": "exact",
      "value": [
        "secrets.json"
      ],
      "channels": [
        "git",
        "archive",
        "npm"
      ],
      "samples": [
        "secrets.json"
      ]
    },
    {
      "label": "ChatGPT plan tokens",
      "match": "exact",
      "value": [
        "chatgpt_auth.json",
        "chatgpt_auth.json.lock"
      ],
      "channels": [
        "git",
        "archive",
        "npm"
      ],
      "samples": [
        "chatgpt_auth.json",
        "chatgpt_auth.json.lock"
      ],
      "note": "ROADMAP_v3 §83 (CG4). The ChatGPT-plan sign-in's access and refresh tokens, written beside providers.json; the .lock is the empty file its refreshes serialize on."
    },
    {
      "label": "local databases and their WAL sidecars",
      "match": "suffix",
      "value": [
        ".db",
        ".db-wal",
        ".db-shm"
      ],
      "channels": [
        "git",
        "archive",
        "npm"
      ],
      "samples": [
        "app.db",
        "app.db-wal",
        "app.db-shm"
      ]
    },
    {
      "label": "logs",
      "match": "dir",
      "value": [
        "logs"
      ],
      "channels": [
        "git",
        "archive",
        "npm"
      ],
      "samples": [
        "logs/app.log"
      ]
    },
    {
      "label": "research output",
      "match": "dir",
      "value": [
        "output"
      ],
      "channels": [
        "git",
        "archive",
        "npm"
      ],
      "samples": [
        "output/run-1/report.md"
      ]
    },
    {
      "label": "compiled python",
      "match": "suffix-or-segment",
      "value": [
        ".pyc",
        "__pycache__"
      ],
      "channels": [
        "git",
        "npm"
      ],
      "samples": [
        "x.pyc",
        "__pycache__/README.txt"
      ],
      "note": "No archive row by decision (S18-08): `git archive` ships only TRACKED content, so export-ignore on a gitignored path is belt and braces. The row that mattered there was .venastine/."
    },
    {
      "label": "notebook checkpoints",
      "match": "segment",
      "value": [
        ".ipynb_checkpoints"
      ],
      "channels": [
        "git",
        "archive",
        "npm"
      ],
      "samples": [
        ".ipynb_checkpoints/system.md"
      ]
    },
    {
      "label": "security scan artifacts",
      "match": "prefix",
      "value": [
        "CLAUDE-SECURITY"
      ],
      "channels": [
        "git",
        "archive",
        "npm"
      ],
      "samples": [
        "CLAUDE-SECURITY-2026-01-01/report.md"
      ]
    },
    {
      "label": "atomic-write debris",
      "match": "suffix",
      "value": [
        ".tmp"
      ],
      "channels": [
        "git",
        "archive",
        "npm"
      ],
      "samples": [
        "providers.json.a1b2c3d4.tmp",
        "secrets.json.a1b2c3d4.tmp"
      ]
    },
    {
      "label": "the unsafe-mode branch marker",
      "match": "exact",
      "value": [
        "UNSAFE_BRANCH"
      ],
      "channels": [
        "npm"
      ],
      "samples": [
        "UNSAFE_BRANCH"
      ],
      "note": "npm only, deliberately. UN5 keeps this marker OUT of the tarball while the unsafe branch must be able to track it, so gitignoring it would break the thing it exists to mark."
    },
    {
      "label": "project MCP server configuration",
      "match": "exact",
      "value": [
        ".venastine/mcp.json"
      ],
      "channels": [
        "git",
        "archive",
        "npm"
      ],
      "samples": [
        ".venastine/mcp.json"
      ],
      "note": "S18-01. `env` and `headers` are live fields and README names `Authorization` as where a hosted server's credential rides. The directory is NOT excluded wholesale: .venastine/agents and .venastine/skills are project content meant to travel with the repo, which is what D17's trust prompt exists for."
    },
    {
      "label": "project settings",
      "match": "exact",
      "value": [
        ".venastine/settings.json"
      ],
      "channels": [
        "git",
        "archive",
        "npm"
      ],
      "samples": [
        ".venastine/settings.json"
      ],
      "note": "The sibling `/init --config` writes in the same call as mcp.json, so it travels with it."
    }
  ],
  "files": [
    "bin/",
    "main.py",
    "config.py",
    "config.yaml",
    "config_schema.py",
    "config_edit.py",
    "config_update.py",
    "storage.py",
    "database.py",
    "credentials.py",
    "env_secrets.py",
    "logging_setup.py",
    "json_store.py",
    "core/",
    "tools/",
    "tui/",
    "agents/",
    "skills/",
    "prompts/",
    "mcp_client/",
    "security/",
    "safety/",
    "memories/",
    "project_init/",
    "requirements.txt",
    "pyproject.toml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/THIRD_PARTY_NOTICES.md",
    "CONFIG_ARCHITECTURE.md",
    "docs/SECURITY.md",
    "docs/PRIVACY.md",
    "providers.json.example",
    ".env.example",
    "!**/__pycache__",
    "!**/*.pyc",
    "!**/.ipynb_checkpoints",
    "!**/.pytest_cache"
  ]
}
